# ─────────────────────────────────────────────────────────────────────────────
# 아트브릿지 backend — 운영(Dokploy) 환경 변수 예시
#  · 이 파일은 "무엇을 어떤 모양으로 넣는지"를 보여 주는 견본입니다. 실제 값은 Dokploy의 Environment에만 등록하세요.
#  · API 앱과 메일 작업기(mail-worker) 앱은 같은 값 세트를 쓰고, PROCESS_ROLE 만 다릅니다.
#       API 앱:        PROCESS_ROLE="api"          (시작할 때 DB migration을 적용하고 서버를 켭니다)
#       mail-worker:   PROCESS_ROLE="mail-worker"  (메일 발송 작업기만 실행)
#  · 시작 시 검증에 걸리면 어떤 변수가 문제인지 알려 주며 서버가 켜지지 않습니다(예시 값 그대로 두면 막힙니다).
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. 서버 주소 ──────────────────────────────────────────────────────────────
NODE_ENV="production"
PROCESS_ROLE="api"
PORT=3000
API_PREFIX="/api/v1"
# 사용자가 여는 웹 주소(https 필수). 메일 속 링크의 기준
APP_PUBLIC_URL="https://app.example.com"
# 브라우저가 접근하는 API 주소(https 필수). 파일 올리기·받기 주소의 기준
API_EXTERNAL_URL="https://api.example.com"
# 허용할 웹 주소(https). 여러 개는 쉼표로
CORS_ORIGINS="https://app.example.com"
# Dokploy(Traefik) 뒤에서 실제 접속자 IP로 요청 제한을 하려면 true
RATE_LIMIT_TRUST_PROXY="true"

# ── 2. 데이터베이스 ───────────────────────────────────────────────────────────
# Dokploy PostgreSQL의 내부 연결 주소
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# ── 3. 로그인(JWT·쿠키) ───────────────────────────────────────────────────────
# 각각 다른 32자 이상 난수:  openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-random-32+-characters-A"
JWT_REFRESH_SECRET="replace-with-random-32+-characters-B"
JWT_PASSWORD_RESET_SECRET="replace-with-random-32+-characters-C"
AUTH_REFRESH_COOKIE_SECURE="true"
AUTH_REFRESH_COOKIE_SAMESITE="lax"
AUTH_EXPOSE_DEV_RESET_URL="false"
# 웹(app.example.com)과 API(api.example.com)가 같은 상위 도메인이면 그 도메인. 같은 주소(경로 분리)면 비움
COOKIE_DOMAIN=".example.com"

# ── 4. 메일(Resend) ───────────────────────────────────────────────────────────
MAIL_TRANSPORT="resend"
RESEND_API_KEY="re_replace-with-resend-api-key"
# Resend에서 인증한 도메인의 주소여야 합니다
RESEND_FROM_EMAIL="아트브릿지 <no-reply@example.com>"
RESEND_REPLY_TO="support@example.com"
# (다른 SMTP를 쓸 때) MAIL_TRANSPORT="smtp", MAIL_HOST, MAIL_PORT, MAIL_SECURE, MAIL_USER, MAIL_PASSWORD, MAIL_FROM
# MAIL_WORKER_BATCH_SIZE="25"
# MAIL_WORKER_INTERVAL_MS="30000"
MAIL_WORKER_PROCESSING_TIMEOUT_MS="300000"
# MAIL_WORKER_RETRY_DELAY_MS="300000"
# MAIL_WORKER_MAX_ATTEMPTS="3"
# MAIL_DIGEST_WINDOW_MS="3600000"
# 출석 리마인드 — Dokploy Schedule로 1시간마다 `npm run attendance:reminders:prod` 실행
# ATTENDANCE_REMINDER_LOOKAHEAD_HOURS="24"

# ── 5. 파일 저장소(Cloudflare R2) ─────────────────────────────────────────────
# 브라우저가 서명된 주소로 R2에 직접 올리고 받습니다. 버킷 CORS에 웹 주소(GET·PUT·HEAD)를 허용해야 합니다.
ASSET_STORAGE="r2"
R2_ACCOUNT_ID="0123456789abcdef0123456789abcdef"
R2_ACCESS_KEY_ID="replace-with-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-r2-secret-access-key"
R2_BUCKET="attachment"
# 객체 경로: {R2_KEY_PREFIX}/{R2_PROJECT_NAME}/{폴더}/{연도}/{고유값-파일명}
R2_PROJECT_NAME="reading-musical"
# R2_PROJECT_NAME을 art-bridge로 바꿀 때 기존 파일을 유지하려면 아래에 reading-musical 지정.
# 이전 경로는 같은 버킷·R2_KEY_PREFIX에서만 읽으며 새 파일은 R2_PROJECT_NAME에 저장.
# R2_LEGACY_PROJECT_NAMES=""
# R2_KEY_PREFIX=""
# R2_ENDPOINT=""
# R2_REGION="auto"
# 예전에 서버 디스크에 올린 파일을 계속 열 수 있도록 이 경로의 Volume은 유지합니다(새 파일은 R2로 갑니다).
ASSET_OBJECT_DIR="/app/.asset-objects"
# SIGNED_URL_TTL="600"
# UPLOAD_URL_TTL="3600"

# ── 6. AI 대본 구성(선택) ─────────────────────────────────────────────────────
# OpenAI 호환 공급자 하나를 고릅니다. 예) Google Gemini
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_API_KEY="replace-with-llm-api-key"
LLM_MODEL="gemini-2.5-flash"
# LLM_TIMEOUT_MS="150000"
# LLM_MAX_RETRIES="1"
# LLM_TEMPERATURE="1"
# LLM_TOP_P="0.95"
# LLM_MAX_TOKENS="16384"
# LLM_SEED="42"
# LLM_JSON_MODE="false"
# 예) NVIDIA: LLM_BASE_URL="https://integrate.api.nvidia.com/v1", NVIDIA_API_KEY="nvapi-...", LLM_MODEL="deepseek-ai/deepseek-v4-pro-0813",
#     LLM_EXTRA_BODY_JSON={"chat_template_kwargs":{"thinking":false}}

# ── 7. 운영 보조 ──────────────────────────────────────────────────────────────
# API 문서(/api/docs) 공개 여부 — 운영 기본은 비공개
# SWAGGER_ENABLED="false"
# 요청 제한(분당) 기본값은 .env.example 의 7번 항목 참고(RATE_LIMIT_{항목}_LIMIT / _WINDOW_MS)

# ── 8. 처음 한 번만 ───────────────────────────────────────────────────────────
# 첫 총관리자 계정: 배포 후 API 컨테이너 터미널에서 한 번 실행합니다(시연 공연·계정을 만드는 prisma:seed는 운영에서 쓰지 않습니다).
#   ADMIN_EMAIL="you@example.com" ADMIN_PASSWORD="12자-이상-비밀번호" node scripts/create-admin.cjs
# ADMIN_* 는 평소 환경변수에 두지 않습니다.
