# Dokploy backend 환경 변수 예시입니다.
# 이 파일에는 실제 비밀번호/API key를 넣지 말고 Dokploy Environment에 등록하세요.

# Application
NODE_ENV="production"
PROCESS_ROLE="api"
PORT=3000
APP_PUBLIC_URL="https://app.example.com"
API_EXTERNAL_URL="https://api.example.com"
CORS_ORIGINS="https://app.example.com"
RATE_LIMIT_TRUST_PROXY=true

# Dokploy PostgreSQL 내부 연결 주소
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

# 각각 다른 32자 이상의 난수
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-another-32-random-characters"

# Resend API
# RESEND_FROM_EMAIL의 domain은 Resend에서 인증한 domain이어야 합니다.
MAIL_TRANSPORT="resend"
RESEND_API_KEY="replace-with-resend-api-key"
RESEND_FROM_EMAIL="Reading Musical <no-reply@example.com>"
RESEND_REPLY_TO="support@example.com"
MAIL_WORKER_PROCESSING_TIMEOUT_MS=300000

# 현재는 컨테이너 내부 폴더에 저장합니다.
# 데이터 보존이 필요해지면 Dokploy Volume을 이 경로에 mount하세요.
ASSET_OBJECT_DIR="/app/.asset-objects"

# Optional: AI 대본 구조화 기능을 사용할 때만 설정합니다.
# NVIDIA OpenAI 호환 API가 기본입니다. 실제 키는 Dokploy Environment에 등록하세요.
NVIDIA_API_KEY="replace-with-nvidia-api-key"
LLM_BASE_URL="https://integrate.api.nvidia.com/v1"
LLM_MODEL="deepseek-ai/deepseek-v4-pro-0813"
LLM_TEMPERATURE=1
LLM_TOP_P=0.95
LLM_MAX_TOKENS=16384
LLM_SEED=42
LLM_EXTRA_BODY_JSON={"chat_template_kwargs":{"thinking":false}}
# 다른 공급자를 쓸 때는 NVIDIA_API_KEY를 지우고 LLM_API_KEY와 해당 LLM_BASE_URL을 설정합니다.
# LLM_API_KEY=""
