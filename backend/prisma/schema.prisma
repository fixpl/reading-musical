generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  SUPER_ADMIN
  ORG_ADMIN
  MEMBER
  @@map("platform_role")
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  @@map("organization_status")
}

enum AdminSettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  @@map("admin_setting_value_type")
}

enum ProfileType {
  ACTOR
  STAFF
  DIRECTOR
  MUSIC_DIRECTOR
  STAGE_MANAGER
  PLANNER
  OTHER
  @@map("profile_type")
}

enum ProductionRole {
  PRODUCER
  DIRECTOR
  MUSIC_DIRECTOR
  STAGE_MANAGER
  ACTOR
  STAFF
  GUEST
  @@map("production_role")
}

enum StaffDiscipline {
  SOUND
  LIGHTING
  STAGE_CREW
  PROPS
  COSTUME
  MAKEUP
  VIDEO
  FRONT_OF_HOUSE
  PRODUCTION_ASSISTANT
  ACCOMPANIST
  OTHER
  @@map("staff_discipline")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
  @@map("gender")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  @@map("user_status")
}

enum RecruitmentRoundStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
  @@map("recruitment_round_status")
}

enum RecruitmentPositionRole {
  ACTOR
  STAFF
  @@map("recruitment_position_role")
}

enum RecruitmentApplicationStatus {
  SUBMITTED
  REVIEWING
  ON_HOLD
  APPROVED
  NOT_SELECTED
  WITHDRAWN
  CANCELLED
  @@map("recruitment_application_status")
}

enum Phase {
  PLANNING
  READING
  REHEARSAL
  PERFORMANCE
  @@map("phase")
}

enum Visibility {
  DRAFT
  PUBLISHED
  @@map("visibility")
}

enum EventType {
  READING
  MUSIC_PRACTICE
  REHEARSAL
  ENSEMBLE
  PERFORMANCE
  @@map("event_type")
}

enum AttendanceStatus {
  INVITED
  ACCEPTED
  DECLINED
  TENTATIVE
  @@map("attendance_status")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  @@map("invite_status")
}

enum AssetKind {
  AUDIO
  IMAGE
  DOCUMENT
  VIDEO
  @@map("asset_kind")
}

enum SceneBlockType {
  DIALOGUE
  LYRIC
  STAGE_DIRECTION
  NOTE
  @@map("scene_block_type")
}

enum AnnotationType {
  DIRECTION
  PRONUNCIATION
  ACTING
  NOTE
  @@map("annotation_type")
}

enum AnchorStatus {
  OK
  UNLINKED
  BROKEN
  @@map("anchor_status")
}

enum CastAssignmentKind {
  MAIN
  DOUBLE
  UNDERSTUDY
  @@map("cast_assignment_kind")
}

enum CueType {
  START
  BGM
  STOP
  PAUSE
  RESUME
  SFX
  MIC
  NOTE
  @@map("cue_type")
}

enum CueFireMode {
  MANUAL
  AUTO_MARKER
  @@map("cue_fire_mode")
}

enum ChecklistStatus {
  TODO
  IN_PROGRESS
  WAITING_APPROVAL
  DONE
  BLOCKED
  @@map("checklist_status")
}

enum LinkedResourceType {
  SCRIPT
  SCENE
  SCENE_BLOCK
  MUSIC_CUE
  STAGE_PLAN
  EVENT
  ASSET
  RUN_SHEET
  RUN_SHEET_ITEM
  @@map("linked_resource_type")
}

enum RunSheetStatus {
  DRAFT
  LOCKED
  COMPLETED
  @@map("run_sheet_status")
}

enum RunSheetItemType {
  SCENE
  CUE
  STAGE_NOTE
  CHECK
  BREAK
  ANNOUNCEMENT
  @@map("run_sheet_item_type")
}

enum EmailDeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  SKIPPED
  @@map("email_delivery_status")
}

model User {
  id String @id @default(uuid())
  organizationId String? @map("organization_id")
  organization Organization? @relation(fields: [organizationId], references: [id])
  email String @unique
  passwordHash String @map("password_hash")
  name String
  phone String?
  gender Gender @default(UNSPECIFIED)
  birthDate DateTime? @map("birth_date")
  address String?
  profileType ProfileType @default(ACTOR) @map("profile_type")
  profileDetails Json? @map("profile_details")
  photoAssetId String? @map("photo_asset_id")
  profileComplete Boolean @default(false) @map("profile_complete")
  status UserStatus @default(ACTIVE)
  failedLoginCount Int @default(0) @map("failed_login_count")
  lockedUntil DateTime? @map("locked_until")
  emailNotify Boolean @default(true) @map("email_notify")
  // 서비스 알림과 광고 수신 동의는 별개다. 기존 회원의 동의를 추정하지 않는다.
  marketingPrivacy Boolean @default(false) @map("marketing_privacy")
  marketingEmail Boolean @default(false) @map("marketing_email")
  marketingRevision Int @default(0) @map("marketing_revision")
  marketingUpdatedAt DateTime? @map("marketing_updated_at")
  consentEvents ConsentEvent[]
  supportTickets SupportTicket[]
  platformRole PlatformRole @default(MEMBER) @map("platform_role")
  memberships Membership[]
  recruitmentApplications RecruitmentApplication[]
  availabilities Availability[]
  emailDeliveries EmailDelivery[]
  authSessions AuthSession[]
  personalRehearsals PersonalRehearsal[]
  assets Asset[]
  handledInquiries Inquiry[] @relation("InquiryHandledBy")
  planningMemos PlanningMemo[]
  boardPosts BoardPost[]
  boardComments BoardComment[]
  trackCues TrackCue[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([organizationId])
  @@index([profileType])
  @@index([status])
  @@index([lockedUntil])
  @@map("users")
}

model RegistrationEmailChallenge {
  id String @id @default(uuid())
  email String
  codeHash String @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts Int @default(0)
  verifiedAt DateTime? @map("verified_at")
  proofHash String? @unique @map("proof_hash")
  proofExpiresAt DateTime? @map("proof_expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([email, createdAt])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("registration_email_challenges")
}

model AuthSession {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id])
  tokenHash String @map("token_hash")
  expiresAt DateTime @map("expires_at")
  lastRotatedAt DateTime @default(now()) @map("last_rotated_at")
  revokedAt DateTime? @map("revoked_at")
  revokedReason String? @map("revoked_reason")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model Organization {
  id String @id @default(uuid())
  name String
  status OrganizationStatus @default(ACTIVE)
  users User[]
  productions Production[]
  activityLogs ActivityLog[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  @@map("organizations")
}

model Production {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  organization Organization @relation(fields: [organizationId], references: [id])
  title String
  slug String? @unique
  synopsis String? @db.Text
  description String? @db.Text
  venue String?
  startDate DateTime? @map("start_date")
  endDate DateTime? @map("end_date")
  currentPhase Phase @default(PLANNING) @map("current_phase")
  visibility Visibility @default(DRAFT)
  archived Boolean @default(false)
  // 공연 뒷배경 영상 — 큐시트 타임라인 재생 시 기준 시계가 되는 영상 파일.
  backgroundAssetId String? @map("background_asset_id")
  backgroundAsset Asset? @relation("ProductionBackground", fields: [backgroundAssetId], references: [id])
  // 소프트 삭제: 실제 데이터는 지우지 않고 이 필드로 "삭제됨(휴지통)"을 표시한다. 목록·접근에서 제외, 복구 가능.
  deletedAt DateTime? @map("deleted_at")
  // 장·막 구성의 동시 편집 충돌을 방지하는 낙관적 잠금 버전.
  compositionRevision Int @default(0) @map("composition_revision")
  showcase ProductionShowcase?
  recruitmentRounds RecruitmentRound[]
  sections PerformanceSection[]
  personalRehearsals PersonalRehearsal[]
  positionRequirements PositionRequirement[]
  memberships Membership[]
  scripts Script[]
  roles Role[]
  musicTracks MusicTrack[]
  musicCues MusicCue[]
  stagePlans StagePlan[]
  events ScheduleEvent[]
  runSheets RunSheet[]
  guestReadingAccesses GuestReadingAccess[]
  staffAssignments StaffAssignment[]
  checklistPhases ChecklistPhase[]
  notifications Notification[]
  invitations Invitation[]
  emailDeliveries EmailDelivery[]
  activityLogs ActivityLog[]
  readingSessions ReadingSession[]
  assets Asset[]
  inquiries Inquiry[]
  planningMemos PlanningMemo[]
  boardPosts BoardPost[]
  cueTracks CueTrack[]
  trackCues TrackCue[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([organizationId])
  @@unique([organizationId, title])
  @@map("productions")
}

model Membership {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id])
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id])
  primaryRole ProductionRole @map("primary_role")
  roles MembershipRole[]
  staffAssignments StaffAssignment[]
  castAssignments CastAssignment[]
  creditConsent PerformanceCreditConsent?
  recruitmentApplications RecruitmentApplication[]
  attendances Attendance[]
  checklistAssignments ChecklistAssignment[]
  ownedRunSheetItems RunSheetItem[]
  ownedCueTracks CueTrack[]
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([userId, productionId])
  @@index([productionId])
  @@map("memberships")
}

model MembershipRole {
  id String @id @default(uuid())
  membershipId String @map("membership_id")
  membership Membership @relation(fields: [membershipId], references: [id])
  role ProductionRole
  grantedById String? @map("granted_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([membershipId, role])
  @@index([role])
  @@map("membership_roles")
}

// 운영용 공개 상태와 관객에게 게시하는 소개를 분리한다. 초안 저장은 공개본을 바꾸지 않는다.
model ProductionShowcase {
  id String @id @default(uuid())
  productionId String @unique @map("production_id")
  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  draft Json
  published Json?
  publishedAt DateTime? @map("published_at")
  publishedById String? @map("published_by_id")
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([publishedAt])
  @@map("production_showcases")
}

// 이름과 사진은 공연별로 본인이 동의한다. 사진은 당시 파일과 본문 지문까지 고정한다.
model PerformanceCreditConsent {
  id String @id @default(uuid())
  membershipId String @unique @map("membership_id")
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  displayName String @map("display_name")
  showName Boolean @default(false) @map("show_name")
  showPhoto Boolean @default(false) @map("show_photo")
  photoAssetId String? @map("photo_asset_id")
  photoFingerprint String? @map("photo_fingerprint")
  noticeVersion String @map("notice_version")
  consentedAt DateTime? @map("consented_at")
  revokedAt DateTime? @map("revoked_at")
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("performance_credit_consents")
}

// 모집 조건은 게시 후 고정하고, 변경된 모집은 새 회차로 관리한다.
model RecruitmentRound {
  id String @id @default(uuid())
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  title String
  summary String
  description String @db.Text
  region String
  activityStartDate DateTime? @db.Date @map("activity_start_date")
  activityEndDate DateTime? @db.Date @map("activity_end_date")
  conditions String @db.Text
  deadlineAt DateTime? @map("deadline_at")
  status RecruitmentRoundStatus @default(DRAFT)
  revision Int @default(1)
  createdById String @map("created_by_id")
  publishedAt DateTime? @map("published_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  positions RecruitmentPosition[]
  applications RecruitmentApplication[]
  @@index([productionId, createdAt])
  @@index([status, publishedAt])
  @@map("recruitment_rounds")
}

model RecruitmentPosition {
  id String @id @default(uuid())
  roundId String @map("round_id")
  round RecruitmentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  role RecruitmentPositionRole
  label String
  capacity Int
  order Int
  applications RecruitmentApplication[]
  @@unique([id, roundId])
  @@index([roundId, order])
  @@map("recruitment_positions")
}

// 지원은 내부 자료 접근권을 주지 않는다. 승인 transaction에서만 해당 공연 역할을 추가한다.
model RecruitmentApplication {
  id String @id @default(uuid())
  roundId String @map("round_id")
  round RecruitmentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  positionId String @map("position_id")
  position RecruitmentPosition @relation(fields: [positionId, roundId], references: [id, roundId], onDelete: Cascade)
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id])
  status RecruitmentApplicationStatus @default(SUBMITTED)
  revision Int @default(1)
  message String @db.Text
  availability String @db.Text
  reviewMessage String? @db.Text @map("review_message")
  reviewedById String? @map("reviewed_by_id")
  reviewedAt DateTime? @map("reviewed_at")
  membershipId String? @map("membership_id")
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  events RecruitmentApplicationEvent[]
  @@unique([roundId, userId])
  @@index([userId, updatedAt])
  @@index([positionId, status])
  @@map("recruitment_applications")
}

model RecruitmentApplicationEvent {
  id String @id @default(uuid())
  applicationId String @map("application_id")
  application RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus RecruitmentApplicationStatus? @map("from_status")
  toStatus RecruitmentApplicationStatus @map("to_status")
  actorId String @map("actor_id")
  message String? @db.Text
  revision Int
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([applicationId, revision])
  @@map("recruitment_application_events")
}

model StaffAssignment {
  id String @id @default(uuid())
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id])
  membershipId String @map("membership_id")
  membership Membership @relation(fields: [membershipId], references: [id])
  discipline StaffDiscipline
  assignmentKey String @map("assignment_key")
  customLabel String? @map("custom_label")
  isLead Boolean @default(false) @map("is_lead")
  note String?
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([membershipId, assignmentKey])
  @@index([productionId, discipline])
  @@map("staff_assignments")
}

model Invitation {
  id String @id @default(uuid())
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id])
  email String
  role ProductionRole
  token String @unique
  status InviteStatus @default(PENDING)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([productionId])
  @@map("invitations")
}

model PositionRequirement {
  id String @id @default(uuid())
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id])
  role ProductionRole
  label String
  requiredCount Int @default(1) @map("required_count")
  @@index([productionId])
  @@map("position_requirements")
}

model Availability {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id])
  title String?
  startAt DateTime @map("start_at")
  endAt DateTime @map("end_at")
  isAvailable Boolean @default(false) @map("is_available")
  reason String?
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId, startAt])
  @@map("availabilities")
}

model Script {
  id String @id @default(uuid())
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id])
  title String
  imports ScriptImport[]
  sectionSources PerformanceSection[] @relation("SectionSourceScript")
  acts Act[]
  versions ScriptVersion[]
  // 소프트 삭제(휴지통) — 실데이터는 남기고 목록·큐시트에서 감춘다. 복구 가능.
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([productionId])
  @@map("scripts")
}

model ScriptImport {
  id String @id @default(uuid())
  scriptId String @map("script_id")
  script Script @relation(fields: [scriptId], references: [id])
  assetId String @map("asset_id")
  asset Asset @relation(fields: [assetId], references: [id])
  status String @default("DRAFT") // DRAFT | APPLIED | REJECTED | FAILED
  parsedJson Json? @map("parsed_json")
  errorMessage String? @map("error_message")
  createdById String @map("created_by_id")
  appliedAt DateTime? @map("applied_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([scriptId, status])
  @@map("script_imports")
}

model Act {
  id String @id @default(uuid())
  scriptId String @map("script_id")
  script Script @relation(fields: [scriptId], references: [id])
  order Int
  title String
  scenes Scene[]
  @@map("acts")
}

model Scene {
  id String @id @default(uuid())
  actId String @map("act_id")
  act Act @relation(fields: [actId], references: [id])
  order Int
  title String
  summary String?
  blocks SceneBlock[]
  sectionSources PerformanceSection[] @relation("SectionSourceScene")
  sceneRoles SceneRole[]
  cues MusicCue[]
  annotations Annotation[]
  eventScenes EventScene[]
  stageNotes StageSceneNote[]
  runSheetItems RunSheetItem[]
  @@index([actId])
  @@map("scenes")
  trackCues TrackCue[]
}

model SceneBlock {
  id String @id @default(uuid())
  sceneId String @map("scene_id")
  scene Scene @relation(fields: [sceneId], references: [id])
  order Int
  type SceneBlockType
  characterId String? @map("character_id")
  character Role? @relation(fields: [characterId], references: [id])
  text String @db.Text
  cueLabel String? @map("cue_label")
  // 타임라인 배치(밀리초) — 배경 영상 기준으로 이 블록이 언제부터 얼마나 보이는지. null이면 자동 흐름 배치.
  startMs Int? @map("start_ms")
  durationMs Int? @map("duration_ms")
  annotations Annotation[]
  musicCues MusicCue[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([sceneId, order])
  @@index([characterId])
  @@map("scene_blocks")
}

model ScriptVersion {
  id String @id @default(uuid())
  scriptId String @map("script_id")
  script Script @relation(fields: [scriptId], references: [id])
  label String
  snapshot Json
  authorId String @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([scriptId])
  @@map("script_versions")
}

model Annotation {
  id String @id @default(uuid())
  sceneId String @map("scene_id")
  scene Scene @relation(fields: [sceneId], references: [id])
  anchorBlockId String? @map("anchor_block_id")
  anchorBlock SceneBlock? @relation(fields: [anchorBlockId], references: [id])
  authorId String @map("author_id")
  type AnnotationType
  content String @db.Text
  isShared Boolean @default(false) @map("is_shared")
  anchorStatus AnchorStatus @default(OK) @map("anchor_status")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([sceneId])
  @@index([anchorBlockId])
  @@map("annotations")
}

model Role {
  id String @id @default(uuid())
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id])
  name String
  description String?
  assignments CastAssignment[]
  sceneRoles SceneRole[]
  dialogueBlocks SceneBlock[]
  trackCues TrackCue[]
  @@index([productionId])
  @@map("roles")
}

model CastAssignment {
  id String @id @default(uuid())
  roleId String @map("role_id")
  role Role @relation(fields: [roleId], references: [id])
  membershipId String @map("membership_id")
  membership Membership @relation(fields: [membershipId], references: [id])
  kind CastAssignmentKind @default(MAIN)
  @@unique([roleId, membershipId])
  @@map("cast_assignments")
}

model SceneRole {
  id String @id @default(uuid())
  sceneId String @map("scene_id")
  scene Scene @relation(fields: [sceneId], references: [id])
  roleId String @map("role_id")
  role Role @relation(fields: [roleId], references: [id])
  lineCount Int @default(0) @map("line_count")
  songCount Int @default(0) @map("song_count")
  @@unique([sceneId, roleId])
  @@map("scene_roles")
}

model MusicTrack {
  id String @id @default(uuid())
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id])
  assetId String @map("asset_id")
  asset Asset @relation(fields: [assetId], references: [id])
  title String
  durationMs Int? @map("duration_ms")
  waveformPeaksJson Json? @map("waveform_peaks_json")
  cues MusicCue[]
  createdAt DateTime @default(now()) @map("created_at")
  @@index([productionId])
  @@index([assetId])
  @@map("music_tracks")
}

model MusicCue {
  id String @id @default(uuid())
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id])
  trackId String @map("track_id")
  track MusicTrack @relation(fields: [trackId], references: [id])
  sceneId String? @map("scene_id")
  scene Scene? @relation(fields: [sceneId], references: [id])
  anchorBlockId String? @map("anchor_block_id")
  anchorBlock SceneBlock? @relation(fields: [anchorBlockId], references: [id])
  cueNumber String @map("cue_number")
  cueType CueType @default(START) @map("cue_type")
  order Int
  trackStartMs Int @default(0) @map("track_start_ms")
  trackEndMs Int? @map("track_end_ms")
  fadeInMs Int @default(0) @map("fade_in_ms")
  fadeOutMs Int @default(0) @map("fade_out_ms")
