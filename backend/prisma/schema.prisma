  production Production? @relation(fields: [productionId], references: [id])
  userId String @map("user_id")
  type String
  payload Json
  readAt DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId, readAt])
  @@map("notifications")
}

model EmailDelivery {
  id String @id @default(uuid())
  userId String? @map("user_id")
  user User? @relation(fields: [userId], references: [id])
  productionId String? @map("production_id")
  production Production? @relation(fields: [productionId], references: [id])
  toEmail String @map("to_email")
  subject String
  bodyText String @db.Text @map("body_text")
  templateKey String @map("template_key")
  status EmailDeliveryStatus @default(QUEUED)
  attempts Int @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at")
  nextAttemptAt DateTime? @map("next_attempt_at")
  skippedReason String? @map("skipped_reason")
  providerMessageId String? @map("provider_message_id")
  errorMessage String? @map("error_message")
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  sentAt DateTime? @map("sent_at")
  @@index([userId, createdAt])
  @@index([productionId, createdAt])
  @@index([toEmail])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@map("email_deliveries")
}

model ActivityLog {
  id String @id @default(uuid())
  productionId String? @map("production_id")
  production Production? @relation(fields: [productionId], references: [id])
  organizationId String? @map("organization_id")
  organization Organization? @relation(fields: [organizationId], references: [id])
  actorId String @map("actor_id")
  action String
  entity String
  entityId String @map("entity_id")
  reason String?
  beforeJson Json? @map("before_json")
  afterJson Json? @map("after_json")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([productionId, createdAt])
  @@index([productionId, action, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([actorId, createdAt])
  @@index([actorId, action, createdAt])
  @@index([entityId, createdAt])
  @@index([entity, entityId, action, createdAt])
  @@map("activity_logs")
}

model Asset {
