model TrackCue {
  id String @id @default(uuid())
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id])
  trackId String @map("track_id")
  track CueTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  sceneId String? @map("scene_id")
  scene Scene? @relation(fields: [sceneId], references: [id])
  cueNumber String @map("cue_number")
  trigger String?
  content String @db.Text
  note String?
  // 배우 큐의 인물 태그 — 인물별 보기/서브레인 (프롬프트북의 인물별 등퇴장 표기 관례)
  characterId String? @map("character_id")
  character Role? @relation(fields: [characterId], references: [id])
  // 예상 소요 초 — QLab처럼 큐마다 duration을 두어 타임라인을 실제 시간에 가깝게 한다
  durationSec Int? @map("duration_sec")
  // 공연 시작 기준 실제 시작 시각(ms). null은 미지정이며 화면의 자동 배치와 구분한다.
  startMs Int? @map("start_ms")
  // 첨부 미디어(영상·음원) — 영상/음악 트랙 큐가 실제 파일을 가리킨다.
  assetId String? @map("asset_id")
  asset Asset? @relation(fields: [assetId], references: [id])
  // 소프트 삭제(휴지통) — 큐 삭제·큐시트 초기화 시 실데이터는 남기고 감춘다. 복구 가능.
  deletedAt DateTime? @map("deleted_at")
  order Int @default(0)
  authorId String @map("author_id")
  author User @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productionId, trackId, order])
  @@index([sceneId])
  @@index([characterId])
  @@map("track_cues")
}

// 기존 Script/Scene과 일정·주석·큐 연결은 유지한다. 새 구성은 검수 후 복사하여 생성한다.
model PerformanceSection {
  id String @id @default(uuid())
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id])
  parentId String? @map("parent_id")
  parent PerformanceSection? @relation("SectionHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children PerformanceSection[] @relation("SectionHierarchy")
  kind String @default("CHAPTER")
  title String
  order Int @default(0)
  scriptText String @default("") @db.Text @map("script_text")
  lyrics String @default("") @db.Text
  // 최상위는 공연 시작 기준, 하위는 부모 시작 기준. null은 앞 구간에 자동 연결.
  startMs Int? @map("start_ms")
  // null은 하위 구간과 자료 길이로 계산한다. 빈 최하위 구간은 기본 60초.
  durationMs Int? @map("duration_ms")
  backgroundMode String @default("INHERIT") @map("background_mode")
  musicMode String @default("INHERIT") @map("music_mode")
  scoreMode String @default("INHERIT") @map("score_mode")
  sourceScriptId String? @map("source_script_id")
  sourceScript Script? @relation("SectionSourceScript", fields: [sourceScriptId], references: [id], onDelete: SetNull)
  sourceSceneId String? @map("source_scene_id")
  sourceScene Scene? @relation("SectionSourceScene", fields: [sourceSceneId], references: [id], onDelete: SetNull)
  media PerformanceMedia[]
  deletedAt DateTime? @map("deleted_at")
  archiveBatchId String? @map("archive_batch_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([productionId, parentId, order])
  @@index([sourceScriptId])
  @@index([sourceSceneId])
  @@map("performance_sections")
}

model PerformanceMedia {
  id String @id @default(uuid())
  sectionId String @map("section_id")
  section PerformanceSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assetId String @map("asset_id")
  asset Asset @relation(fields: [assetId], references: [id])
  // SCORE(악보 페이지), BACKGROUND, MUSIC, SOURCE(가져오기 원본).
  slot String
  label String
  order Int @default(0)
  offsetMs Int @default(0) @map("offset_ms")
  durationMs Int? @map("duration_ms")
  sourceStartMs Int @default(0) @map("source_start_ms")
  page Int @default(1)
  volume Float @default(1)
  loop Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([sectionId, slot, order])
  @@index([assetId])
  @@map("performance_media")
}

// 개인 연습 기록은 공연·사용자·연습 대본별로 분리한다. 공유 리딩 세션의 시계를 변경하지 않는다.
// 공개한 문서는 수정·삭제하지 않고 새 버전을 발행한다.
model LegalDocument {
  id String @id @default(uuid())
  kind String
  version Int
  title String
  body String @db.Text
  purpose String @default("") @db.Text
  items String @default("") @db.Text
  retention String @default("") @db.Text
  refusal String @default("") @db.Text
  effectiveAt DateTime @map("effective_at")
  publishedAt DateTime? @map("published_at")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  consentEvents ConsentEvent[]
  supportTickets SupportTicket[]
  inquiries Inquiry[]
  @@unique([kind, version])
  @@index([kind, effectiveAt, publishedAt])
  @@map("legal_documents")
}

model ConsentEvent {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind String
  granted Boolean
  documentId String? @map("document_id")
  document LegalDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  source String
  createdAt DateTime @default(now()) @map("created_at")
  @@index([userId, createdAt])
  @@map("consent_events")
}

model FaqCategory {
  id String @id @default(uuid())
  name String @unique
  order Int @default(0)
  active Boolean @default(true)
  revision Int @default(1)
  questions FaqQuestion[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("faq_categories")
}

model FaqQuestion {
  id String @id @default(uuid())
  categoryId String @map("category_id")
  category FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title String
  body String @db.Text
  order Int @default(0)
  active Boolean @default(true)
  revision Int @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([categoryId, active, order])
  @@map("faq_questions")
}

model SupportTicket {
  id String @id @default(uuid())
  userId String? @map("user_id")
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  // 비회원 조회 키 원문은 저장하거나 URL에 넣지 않는다.
  guestKeyHash String? @map("guest_key_hash")
  contactName String @map("contact_name")
  email String
  category String
  subject String
  message String @db.Text
  answer String? @db.Text
  internalNote String? @db.Text @map("internal_note")
  status String @default("OPEN")
  revision Int @default(1)
  privacyDocumentId String @map("privacy_document_id")
  privacyDocument LegalDocument @relation(fields: [privacyDocumentId], references: [id], onDelete: Restrict)
  privacyConsentedAt DateTime @default(now()) @map("privacy_consented_at")
  answeredAt DateTime? @map("answered_at")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([expiresAt])
  @@map("support_tickets")
}

model PersonalRehearsal {
  id String @id @default(uuid())
  userId String @map("user_id")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  source String
  positionMs Int @default(0) @map("position_ms")
  completedKeys String[] @default([]) @map("completed_keys")
  notes Json @default("{}")
  revision Int @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  @@unique([userId, productionId, source])
  @@index([productionId])
  @@map("personal_rehearsals")
}
