model SystemSetting {
  key String @id
  value Json
  valueType AdminSettingValueType @default(JSON) @map("value_type")
  description String?
  updatedById String? @map("updated_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("system_settings")
}

enum InquiryStatus {
  NEW
  IN_REVIEW
  REPLIED
  CONVERTED
  CLOSED

  @@map("inquiry_status")
}

model Inquiry {
  id String @id @default(uuid())
  orgName String @map("org_name")
  contactName String @map("contact_name")
  email String
  phone String?
  preferredTiming String? @map("preferred_timing")
  audience String?
  message String @db.Text
  status InquiryStatus @default(NEW)
  adminNote String? @db.Text @map("admin_note")
  // 기획 단계 내용 — 문의를 보고 공연 기획을 정리하는 작성란. 전환 시 공연 기획 메모로 이관.
  planningNote String? @db.Text @map("planning_note")
  handledById String? @map("handled_by_id")
  handledBy User? @relation("InquiryHandledBy", fields: [handledById], references: [id])
  productionId String? @map("production_id")
  production Production? @relation(fields: [productionId], references: [id])
  planningMemos PlanningMemo[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("inquiries")
}

model PlanningMemo {
  id String @id @default(uuid())
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id])
  authorId String @map("author_id")
  author User @relation(fields: [authorId], references: [id])
  body String @db.Text
  inquiryId String? @map("inquiry_id")
  inquiry Inquiry? @relation(fields: [inquiryId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productionId, createdAt])
  @@map("planning_memos")
}

enum BoardCategory {
  NOTICE
  QUESTION
  MATERIAL

  @@map("board_category")
}

model BoardPost {
  id String @id @default(uuid())
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id])
  authorId String @map("author_id")
  author User @relation(fields: [authorId], references: [id])
  category BoardCategory @default(QUESTION)
  title String
  body String @db.Text
  pinned Boolean @default(false)
  comments BoardComment[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productionId, pinned, createdAt])
  @@map("board_posts")
}

model BoardComment {
  id String @id @default(uuid())
  postId String @map("post_id")
  post BoardPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String @map("author_id")
  author User @relation(fields: [authorId], references: [id])
  body String @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([postId, createdAt])
  @@map("board_comments")
}

model CueTrack {
  id String @id @default(uuid())
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id])
  name String
  order Int @default(0)
  ownerMembershipId String? @map("owner_membership_id")
  ownerMembership Membership? @relation(fields: [ownerMembershipId], references: [id])
  cues TrackCue[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productionId, name])
  @@index([productionId, order])
  @@map("cue_tracks")
}

model TrackCue {
  id String @id @default(uuid())
  productionId String @map("production_id")
  production Production @relation(fields: [productionId], references: [id])
  trackId String @map("track_id")
  track CueTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  sceneId String? @map("scene_id")
  scene Scene? @relation(fields: [sceneId], references: [id])
  cueNumber String @map("cue_number")
  trigger String?
  content String @db.Text
  note String?
  // 배우 큐의 인물 태그 — 인물별 보기/서브레인 (프롬프트북의 인물별 등퇴장 표기 관례)
  characterId String? @map("character_id")
  character Role? @relation(fields: [characterId], references: [id])
  // 예상 소요 초 — QLab처럼 큐마다 duration을 두어 타임라인을 실제 시간에 가깝게 한다
  durationSec Int? @map("duration_sec")
  // 첨부 미디어(영상·음원) — 영상/음악 트랙 큐가 실제 파일을 가리킨다.
  assetId String? @map("asset_id")
  asset Asset? @relation(fields: [assetId], references: [id])
  // 소프트 삭제(휴지통) — 큐 삭제·큐시트 초기화 시 실데이터는 남기고 감춘다. 복구 가능.
  deletedAt DateTime? @map("deleted_at")
  order Int @default(0)
  authorId String @map("author_id")
  author User @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productionId, trackId, order])
  @@index([sceneId])
  @@index([characterId])
  @@map("track_cues")
}
