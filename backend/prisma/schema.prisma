model Inquiry {
  id String @id @default(uuid())
  revision Int @default(1)
  source Json?
  productionSnapshot Json? @map("production_snapshot")
  messages InquiryMessage[]
  accessGrants InquiryAccess[]
  // 기존 문의에는 동의를 소급 생성하지 않는다.
  privacyDocumentId String? @map("privacy_document_id")
  privacyDocument LegalDocument? @relation(fields: [privacyDocumentId], references: [id])
  privacyConsentedAt DateTime? @map("privacy_consented_at")
  orgName String @map("org_name")
  contactName String @map("contact_name")
  email String
  phone String?
  preferredTiming String? @map("preferred_timing")
  audience String?
  message String @db.Text
  status InquiryStatus @default(NEW)
  adminNote String? @db.Text @map("admin_note")
  // 기획 단계 내용 — 문의를 보고 공연 기획을 정리하는 작성란. 전환 시 공연 기획 메모로 이관.
  planningNote String? @db.Text @map("planning_note")
  handledById String? @map("handled_by_id")
  handledBy User? @relation("InquiryHandledBy", fields: [handledById], references: [id])
  productionId String? @map("production_id")
  production Production? @relation(fields: [productionId], references: [id])
  planningMemos PlanningMemo[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([createdAt])
  @@map("inquiries")
}

// 고객의 신청과 공개 답변은 내부 공연 작업 자료와 분리한다.
model InquiryMessage {
  id String @id @default(uuid())
  inquiryId String @map("inquiry_id")
