# ─────────────────────────────────────────────────────────────────────────────
# 아트브릿지 backend — 로컬 개발용 예시 (cp -n .env.example .env 후 값만 채우세요)
#  · 운영(Dokploy) 값은 .env.production.example 을 참고하세요.
#  · 이 파일에 적힌 변수는 모두 코드에서 실제로 읽는 것입니다. 주석 처리된 줄은 "기본값"이며, 바꿀 때만 풀어 쓰면 됩니다.
#  · 실제 비밀값이 든 .env 는 Git에 올리지 않습니다(.gitignore 처리됨).
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. 서버 주소 ──────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
API_PREFIX="/api/v1"
# 사용자가 브라우저로 여는 웹 주소(메일 속 링크의 기준). dev.sh로 띄우면 5179 입니다.
APP_PUBLIC_URL="http://localhost:5179"
# 브라우저에서 접근하는 API 주소(파일 올리기·받기 주소의 기준)
API_EXTERNAL_URL="http://localhost:3000"
# 허용할 웹 주소(쉼표로 여러 개). localhost 와 127.0.0.1 은 서로 다른 주소로 취급됩니다.
CORS_ORIGINS="http://localhost:5179,http://127.0.0.1:5179"

# ── 2. 데이터베이스 ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/musical?schema=public"
# dev.sh: 원격 개발 DB를 쓸 때만 true (운영 DB에는 쓰지 마세요)
# DEV_ALLOW_REMOTE_DB="false"

# ── 3. 로그인(JWT·쿠키) ───────────────────────────────────────────────────────
# 로컬 개발은 아무 값이나 가능합니다. 운영은 서로 다른 32자 이상 난수여야 시작됩니다.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
# 비우면 JWT_REFRESH_SECRET 에서 파생합니다. 운영에서는 따로 두는 것을 권장합니다.
# JWT_PASSWORD_RESET_SECRET=""
# JWT_ACCESS_EXPIRES_IN="15m"
# JWT_REFRESH_EXPIRES_IN="7d"
# AUTH_MAX_FAILED_LOGIN_ATTEMPTS="5"
# AUTH_LOGIN_LOCK_MINUTES="15"
# AUTH_REFRESH_COOKIE_NAME="reading_musical_refresh"
# AUTH_REFRESH_COOKIE_SAMESITE="lax"     # 웹과 API 주소가 서로 다른 사이트면 none(+Secure)
# AUTH_REFRESH_COOKIE_SECURE="false"     # 운영(https)은 반드시 true
# 비밀번호 재설정 링크를 API 응답에 노출(메일 없이 개발할 때만 true). 운영은 반드시 false.
# AUTH_EXPOSE_DEV_RESET_URL="false"
# 웹과 API가 같은 상위 도메인의 다른 하위 도메인일 때만(예: ".example.com"). 로컬은 비움.
# COOKIE_DOMAIN=""
# 앞단 프록시(Traefik 등)가 X-Forwarded-For를 넣어 줄 때만 true — 운영 .env 참고
# RATE_LIMIT_TRUST_PROXY="false"

# ── 4. 메일 ───────────────────────────────────────────────────────────────────
# json: 실제로 보내지 않고 기록만(로컬 기본). smtp / resend 는 운영 예시 참고.
MAIL_TRANSPORT="json"
MAIL_FROM="Reading Musical <no-reply@reading-musical.local>"
# smtp 일 때 (MAIL_USER·MAIL_PASSWORD는 함께 설정)
# MAIL_HOST="localhost"
# MAIL_PORT="1025"
# MAIL_SECURE="false"
# MAIL_USER=""
# MAIL_PASSWORD=""
# resend 일 때 (MAIL_FROM 대신 RESEND_FROM_EMAIL 을 보낸 사람 주소로 씁니다)
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Reading Musical <no-reply@example.com>"
# RESEND_REPLY_TO=""
# 메일 발송 작업기(npm run mail:worker) 설정 — 기본값
# MAIL_WORKER_BATCH_SIZE="25"
# MAIL_WORKER_INTERVAL_MS="30000"
# MAIL_WORKER_PROCESSING_TIMEOUT_MS="300000"
# MAIL_WORKER_RETRY_DELAY_MS="300000"
# MAIL_WORKER_MAX_ATTEMPTS="3"
# MAIL_DIGEST_WINDOW_MS="3600000"
# 출석 리마인드(npm run attendance:reminders)가 미리 살펴볼 시간(시간 단위)
# ATTENDANCE_REMINDER_LOOKAHEAD_HOURS="24"

# ── 5. 파일 저장소(영상·악보·문서) ────────────────────────────────────────────
# local: 이 서버의 폴더(로컬 개발용) / r2: Cloudflare R2(운영 — 브라우저가 R2로 직접 올리고 받음)
ASSET_STORAGE="local"
ASSET_OBJECT_DIR=".asset-objects"
# r2 로 바꿀 때 필요 — 객체 경로: {R2_KEY_PREFIX}/{R2_PROJECT_NAME}/{폴더}/{연도}/{고유값-파일명}
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""                 # R2_BUCKET_NAME 도 인식
# R2_PROJECT_NAME="reading-musical"
# 이전 경로를 유지할 때만 쉼표로 프로젝트 이름 지정. 같은 버킷·R2_KEY_PREFIX만 적용하며 새 파일은 R2_PROJECT_NAME에 저장.
# R2_LEGACY_PROJECT_NAMES=""
# R2_KEY_PREFIX=""
# R2_ENDPOINT=""               # 비우면 https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com (R2_ENDPOINT_URL 도 인식)
# R2_REGION="auto"
# 서명 주소 유효 시간(초): 받기/재생 기본 600, 올리기 기본 3600
# SIGNED_URL_TTL="600"
# UPLOAD_URL_TTL="3600"

# ── 6. AI 대본 구성(선택) — 키가 없어도 공연·일정·연습 화면은 모두 동작합니다 ─────
# NVIDIA 주소(기본)에서는 NVIDIA_API_KEY, 다른 공급자(OpenAI 호환)는 LLM_API_KEY + LLM_BASE_URL.
NVIDIA_API_KEY=""
# LLM_API_KEY=""
# LLM_BASE_URL="https://integrate.api.nvidia.com/v1"
# LLM_MODEL="deepseek-ai/deepseek-v4-pro-0813"
# LLM_TEMPERATURE="1"
# LLM_TOP_P="0.95"
# LLM_MAX_TOKENS="16384"
# LLM_SEED="42"
# LLM_TIMEOUT_MS="150000"       # 모델이 응답하지 않을 때 기다리는 시간(밀리초)
# LLM_MAX_RETRIES="1"
# LLM_JSON_MODE="false"         # 공급자가 JSON 모드를 지원할 때 true
# 공급자별 추가 요청 옵션(JSON). 예: DeepSeek 계열의 thinking 끄기
# LLM_EXTRA_BODY_JSON={"chat_template_kwargs":{"thinking":false}}

# ── 7. 운영 보조 ──────────────────────────────────────────────────────────────
# 운영에서는 API 문서(/api/docs)가 기본 비공개입니다. 켜려면 true.
# SWAGGER_ENABLED="false"
# 컨테이너 안 바인드 주소(기본 0.0.0.0). dev.sh 가 127.0.0.1 로 지정합니다.
# HOST="0.0.0.0"
# 요청 제한 — 기본값. 사용 빈도에 맞춰 바꿀 때만 풀어 쓰세요. 이름 규칙: RATE_LIMIT_{항목}_LIMIT(횟수) / _WINDOW_MS(기간, 기본 60000)
# RATE_LIMIT_LOGIN_LIMIT="60"                   # 로그인
# RATE_LIMIT_LOGIN_WINDOW_MS="60000"
# RATE_LIMIT_REGISTER_LIMIT="20"                # 회원가입
# RATE_LIMIT_REGISTER_WINDOW_MS="60000"
# RATE_LIMIT_PASSWORD_RESET_LIMIT="20"          # 비밀번호 재설정
# RATE_LIMIT_PASSWORD_RESET_WINDOW_MS="60000"
# RATE_LIMIT_PASSWORD_CHANGE_LIMIT="10"         # 비밀번호 변경
# RATE_LIMIT_PASSWORD_CHANGE_WINDOW_MS="60000"
# RATE_LIMIT_USER_SEARCH_LIMIT="120"            # 회원 검색
# RATE_LIMIT_USER_SEARCH_WINDOW_MS="60000"
# RATE_LIMIT_INQUIRY_LIMIT="10"                 # 공연 문의
# RATE_LIMIT_INQUIRY_WINDOW_MS="60000"
# RATE_LIMIT_EVENT_CREATE_LIMIT="30"            # 일정 만들기
# RATE_LIMIT_EVENT_CREATE_WINDOW_MS="60000"
# RATE_LIMIT_AI_DRAFT_LIMIT="5"                 # AI 대본 구성
# RATE_LIMIT_AI_DRAFT_WINDOW_MS="60000"
# RATE_LIMIT_AI_EXTRACT_LIMIT="20"              # 대본 파일 글자 읽기
# RATE_LIMIT_AI_EXTRACT_WINDOW_MS="60000"
# RATE_LIMIT_AI_APPLY_LIMIT="10"                # AI 구성 등록
# RATE_LIMIT_AI_APPLY_WINDOW_MS="60000"
# RATE_LIMIT_AI_MATCH_LIMIT="10"                # 영상 AI 장면 추천
# RATE_LIMIT_AI_MATCH_WINDOW_MS="60000"

# ── 8. 처음 한 번만(시드) — npm run prisma:seed 로 총관리자·시연 계정을 만듭니다 ────
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="change-this-password"
# SEED_ACTOR_EMAIL="actor@example.com"
# SEED_STAFF_EMAIL="staff@example.com"
# SEED_DEMO_PASSWORD="change-this-password"
