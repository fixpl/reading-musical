# 로컬 개발용 예시입니다. 실제 secret이 들어간 .env는 Git에 올리지 마세요.

# Application
NODE_ENV="development"
PORT=3000
APP_PUBLIC_URL="http://localhost:5173"
API_EXTERNAL_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5179"

# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/musical?schema=public"

# Authentication
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"

# 로컬에서는 실제 메일을 보내지 않고 JSON transport를 사용합니다.
MAIL_TRANSPORT="json"
MAIL_FROM="Reading Musical <no-reply@reading-musical.local>"

# 업로드 파일은 backend/.asset-objects에 저장됩니다.
ASSET_OBJECT_DIR=".asset-objects"

# Optional: AI 대본 구조화 기능을 사용할 때만 설정합니다.
# NVIDIA OpenAI 호환 API가 기본입니다. 모델·요청 옵션은 아래 값으로 변경합니다.
NVIDIA_API_KEY=""
LLM_BASE_URL="https://integrate.api.nvidia.com/v1"
LLM_MODEL="deepseek-ai/deepseek-v4-pro-0813"
LLM_TEMPERATURE=1
LLM_TOP_P=0.95
LLM_MAX_TOKENS=16384
LLM_SEED=42
LLM_EXTRA_BODY_JSON={"chat_template_kwargs":{"thinking":false}}
# 다른 공급자를 쓸 때는 NVIDIA_API_KEY를 지우고 LLM_API_KEY와 해당 LLM_BASE_URL을 설정합니다.
# LLM_API_KEY=""
